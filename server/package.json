{
  "name": "ai-workforce-server",
  "version": "1.0.0",
  "description": "Backend API service for AI Workforce Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test:phase13": "tsx src/auth/testPhase13.ts",
    "test:phase14": "tsx src/tasks/testPhase14.ts",
    "test:phase15": "tsx src/agent/testPhase15.ts",
    "test:phase16": "tsx src/integrations/gmail/testPhase16.ts",
    "test:phase17": "tsx src/approvals/testPhase17.ts",
    "test:phase18": "tsx src/jobs/testPhase18.ts",
    "test:phase19": "tsx src/reliability/testPhase19.ts",
    "test:phase21": "tsx src/docker/testPhase21.ts",
    "test:phase22": "tsx src/aws/testPhase22.ts",
    "test:phase24": "tsx src/evals/testPhase24.ts",
    "test:phase23": "tsx src/cicd/testPhase23.ts",
    "test:smoke": "tsx src/cicd/smokeTests.ts",
    "ci:secrets": "tsx -e \"import { scanRepositoryForSecrets } from './src/cicd/secretAudit'; console.log(scanRepositoryForSecrets('../'));\"",
    "db:migrate-rds": "tsx src/db/migrateRds.ts",
    "worker": "tsx src/jobs/workerRunner.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "openai": "^7.28.0",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
