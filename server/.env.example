# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL 8.4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_workforce
DB_CONNECTION_LIMIT=10

# Redis Cache Configuration (Redis 8.10)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=60

# AI / LLM Configuration (Phase 6)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
