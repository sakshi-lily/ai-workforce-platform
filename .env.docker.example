# ==============================================================================
# AI Workforce Platform — Docker Production-Like Local Environment
# Phase 21 Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.docker.example .env
# Then launch the platform:
#   docker compose up -d
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration (Internal Docker Service Discovery)
# ------------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=workforce_user
DB_PASSWORD=workforce_password
DB_NAME=ai_workforce
MYSQL_ROOT_PASSWORD=rootpassword

# ------------------------------------------------------------------------------
# Redis Queue & Distributed Lock Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=internal_knowledge

# ------------------------------------------------------------------------------
# Authentication Security
# ------------------------------------------------------------------------------
JWT_SECRET=ai_workforce_production_jwt_secret_key_phase21_docker_secure_2026

# ------------------------------------------------------------------------------
# External LLM & AI Providers (Inject at runtime — never bake into images)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
SERPAPI_API_KEY=your_serpapi_api_key_here

# ------------------------------------------------------------------------------
# External Integrations (Gmail OAuth 2.0)
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
