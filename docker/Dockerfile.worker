# ==============================================================================
# AI Workforce Platform — Headless Worker Daemon Dockerfile
# Phase 21: Multi-Stage Production Containerization
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Stage
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Install server dependencies deterministically
COPY server/package*.json ./
RUN npm ci

# Copy TypeScript configuration and server source code
COPY server/tsconfig.json ./
COPY server/src ./src

# Inject build metadata
ARG BUILD_TIME
ARG GIT_COMMIT_SHA
ENV BUILD_TIME=${BUILD_TIME}
ENV GIT_COMMIT_SHA=${GIT_COMMIT_SHA}

# Compile TypeScript to JavaScript in /app/dist
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Production Runtime Stage
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Install production-only dependencies
COPY server/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy compiled artifacts from builder stage
COPY --from=builder /app/dist ./dist

# Security: Enforce unprivileged non-root 'node' runtime user (UID 1000)
USER node

# Headless background daemon: zero public ports exposed for minimum attack surface

# Run background worker daemon runner
CMD ["node", "dist/jobs/workerRunner.js"]
